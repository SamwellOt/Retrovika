# Copie para keystore.properties (que fica fora do git) e preencha com a sua chave de release.
# Para criar uma chave:
#   keytool -genkeypair -v -keystore retrovika-release.jks -alias retrovika -keyalg RSA -keysize 4096 -validity 10000
storeFile=retrovika-release.jks
storePassword=
keyAlias=retrovika
keyPassword=
