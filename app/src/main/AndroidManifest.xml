<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Jogar pela rede: trava o Wi-Fi no modo de baixa latência enquanto o servidor está ligado (RemotePlay). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Núcleos sem a VFS do libretro (Play!, bsnes…) precisam do caminho real dos jogos de pastas vinculadas.
         Só é pedida quando um desses jogos é aberto (StorageAccess). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Atualização pelo próprio app (AppUpdater): instala o APK da release nova do GitHub. A segunda
         deixa o Android 12+ atualizar sem confirmação quando a versão instalada veio do próprio app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Downloads da fila num serviço em primeiro plano (DownloadService), para o Android não matar o app no meio.
         Sem a permissão de notificação (Android 13+, não pedida) o serviço roda igual, só sem a notificação visível. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:glEsVersion="0x00030000" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".RetrovikaApp"
        android:largeHeap="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:banner="@drawable/banner"
        android:extractNativeLibs="true"
        android:isGame="true"
        android:appCategory="game"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Retrovika">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Retrovika.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- singleTop: links e arquivos abertos com o app já aberto chegam por onNewIntent, sem uma segunda cópia. -->
            <!-- QR codes de estado compartilhado e de partida em rede: a câmera do celular abre o app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="retrovika" android:host="state" />
                <data android:scheme="retrovika" android:host="netplay" />
            </intent-filter>
            <!-- Estado compartilhado (.rvstate) aberto pelo WhatsApp, Telegram, gerenciador de arquivos… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.retrovika.state" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Pede aos serviços do Google o modelo de OCR japonês já na instalação (tradução ao vivo). -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="ocr_ja" />

        <!-- Pacotes de estado entregues ao menu de compartilhar do Android. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- configChanges evita recriar a Activity (e reiniciar o emulador) ao girar a tela, conectar um controle ou
             mudar idioma, fonte ou cor do sistema: a tela do jogo fica no idioma antigo até sair dele. -->
        <activity
            android:name=".emulation.GameActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.retrovika.app.game"
            android:autoRemoveFromRecents="true"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|locale|layoutDirection|fontScale|colorMode"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Retrovika.Game" />

        <receiver android:name=".core.update.UpdateInstallReceiver" android:exported="false" />

        <service
            android:name=".core.catalog.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
